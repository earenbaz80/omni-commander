{
  "name": "omnicommander-pro",
  "build": {
    "appId": "com.omnicmd.desktop",
    "productName": "OmniCommander Pro",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "server.cjs",
      "server/**/*.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "server.cjs",
      "server/**/*.cjs",
      "dist/**/*",
      "node_modules/libarchive.js/**",
      "node_modules/node-unrar-js/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "earenbaz80",
      "repo": "omni-commander"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniCommander Pro"
    }
  },
  "private": true,
  "version": "1.0.41",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --strictPort",
    "electron:dev": "electron .",
    "electron:build": "npm run build:electron && electron-builder",
    "build:electron": "vite build --mode electron",
    "test:e2e": "playwright test",
    "server": "node --env-file-if-exists=.env server.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dev-dist',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src --max-warnings 0",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:server:coverage": "node scripts/server-coverage.mjs",
    "check:links": "node scripts/check-links.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-git-hooks.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^1.68.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}

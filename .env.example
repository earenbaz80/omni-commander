# Variables de entorno de OmniCommander Pro.
#
# Copia este fichero a `.env` para fijar valores: `npm run dev` y `npm run server`
# lo cargan si existe, y lo que ya venga en el entorno del proceso gana sobre el
# fichero. La app empaquetada con Electron NO lo lee (ahí valen los valores por
# defecto), así que esto configura el flujo de trabajo local, no la distribución.
#
# Todas son opcionales y están comentadas: copiar el fichero sin tocar nada no
# cambia el arranque.

# Puerto preferido del servidor de archivos. Si está ocupado avanza hasta 25
# puertos más (3001-3025); un valor vacío, 0 o no numérico cae al 3001.
# PORT=3001

# Puerto real donde escucha el servidor. Lo publica server.cjs al arrancar; solo
# fíjalo a mano si arrancas el servidor por separado y necesitas que el proxy de
# Vite (o Playwright) apunte a ese puerto concreto.
# OMNI_API_PORT=3001

# Log de depuración del servidor en stderr (prefijo [omni]: sondeos, WMI, cola de
# trabajos). Cualquier valor no vacío lo activa, incluido "0".
# OMNI_DEBUG=1

# "true" apaga el HMR y el watch de ficheros de Vite.
# DISABLE_HMR=false

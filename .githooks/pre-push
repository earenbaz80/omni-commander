#!/usr/bin/env bash
#
# Blocks a push that would fail the CI `verify` job: types first, then the test
# suite. Formatting stays in pre-commit, which is fast; this one is allowed to
# take a minute. `git push --no-verify` skips it when that is what you want.
# A red run is not automatically a regression; the note at the end of this file
# is how to tell one from a machine that had no CPU left to give.
set -eo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# Git writes one line per ref on stdin: local ref, local sha, remote ref, remote
# sha. A branch deletion is all zero shas and has nothing of ours to verify.
only_deletes=true
if [ -t 0 ]; then
  # Run by hand in a terminal: there is no ref list to read, so just do the work.
  only_deletes=false
else
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] || only_deletes=false
  done
fi

if [ "$only_deletes" = true ]; then
  exit 0
fi

# Same reasoning as pre-commit: a clone without `npm install` cannot verify
# anything, and CI still gates the branch.
if [ ! -f node_modules/typescript/bin/tsc ]; then
  echo "pre-push: dependencies are not installed, skipping types and tests (run npm install)"
  exit 0
fi

# Everything below is also written to pre-push.log, which `*.log` keeps out of
# Git. A red run used to leave nothing behind: the suite printed to the terminal,
# the output scrolled away, and the failing file's name was gone by the time
# anyone asked which test it had been — which is how "a test failed" ends up
# with no way to tell a flaky suite from a broken one. The log outlives the run,
# and the hook repeats the culprit's line itself instead of trusting the scroll.
log="pre-push.log"
: >"$log"

# Status is captured before anything else: with `set -e`, the first failure ends
# the script, and this is the only place that knows what the code and the output
# were. Exiting with the same status keeps the push blocked, not accidentally
# allowed by a successful grep in the reporting block.
on_exit() {
  status=$?
  if [ "$status" -ne 0 ]; then
    echo
    echo "pre-push: failed with exit $status. Whole output: $log"
    # The lines that name a file, with the colour codes the log keeps on purpose
    # so it reads like the terminal did. Nothing is printed if the failure had
    # no test in it (a type error, a missing binary).
    sed -E 's/\x1b\[[0-9;]*m//g' "$log" | grep -E '(^|[[:space:]])(FAIL|Test Files[[:space:]].*failed)' | head -20 || true
  fi
  exit "$status"
}
trap on_exit EXIT

# `tee` leaves the terminal output as it was; `pipefail` means the command's
# status, not tee's, is what the script acts on.
run() {
  "$@" 2>&1 | tee -a "$log"
}

echo "pre-push: typechecking (npm run lint)..."
run npm run --silent lint

# The worker count is pinned here for the reason CI pins it: the default opens
# one worker per core, and with four of them on this four-core machine the suite
# has gone red with nothing broken (odd/tasks records the rule: always pass
# --maxWorkers=2). It is not a speed trade: alternating both settings over the
# same half hour, the cap ran 128s/138s/139s against 106s/112s/161s uncapped. It
# costs nothing measurable and turns half a minute of spread into a second.
echo "pre-push: running the test suite (npm test -- --maxWorkers=2)..."
run npm test -- --maxWorkers=2

echo "pre-push: types and tests passed. (output: $log)"

# When this hook goes red, the log says which test and does not say why.
# Contention is one of the answers, and it has been the true one: the same tree
# took 394 s and failed a walk-the-folder test while another project's headless
# browsers held two cores, and 139 s and passed with the box empty. The suite
# got *less* CPU while competing (1.10 cores) than alone (1.53), so the workers
# were waiting and what expired was the test's budget. The tests that break
# this way are the ones doing real work against a clock -- crypto, disk walks,
# spawned processes -- and which one falls is whichever was running at the
# spike, which is why the name in the log changes from run to run.
#
# To tell contention from a broken test, sample the box while the suite runs:
#
#   powershell -NoProfile -File scripts/cpu-sampler.ps1 -Seconds 700 -Out cpu.log
#   npm test -- --maxWorkers=2     # in another window, sampler already running
#
# When it stops, the sampler prints one line per process name with mean cores,
# CPU seconds and peak working set. `node` is this suite; a second name near the
# top is who took the cores. Its CSV puts the name next to the pid on every row,
# so a process that has since exited is still named for the second it worked --
# the usual reason a spike goes unexplained. On Windows only; elsewhere
# `pidstat 1` or `top -b` answer the same question.
#
# Re-running the one failing file on a quiet box (`npm test -- <file>`) proves
# the file, not the budget. Ship only after the suite is green on a quiet
# machine: a test's budget must not be raised to cover for a neighbour's build.
